# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/100_Door_game?retryWrites=true&w=majority

# JWT Secret for user session tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins (CORS)
# Options:
# - Single domain: https://your-site.netlify.app
# - Multiple domains (comma-separated): https://your-site.netlify.app,http://localhost:5173
# - Wildcard pattern: *.netlify.app,*.vercel.app
# - Allow all: *
CLIENT_URL=https://fundsa.netlify.app,http://localhost:5173
